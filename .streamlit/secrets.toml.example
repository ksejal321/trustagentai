# Copy this file to  .streamlit/secrets.toml  and fill in your own values.
# NEVER commit secrets.toml (it is listed in .gitignore). Values must be inside quotes.

GEMINI_API_KEY = "your-gemini-api-key"
PAYPAL_CLIENT_ID = "your-paypal-sandbox-client-id"
PAYPAL_CLIENT_SECRET = "your-paypal-sandbox-client-secret"

# Where PayPal sends the buyer back after they approve the payment.
# Local run: http://localhost:8501   |   Hosted: https://your-app-name.streamlit.app
APP_BASE_URL = "http://localhost:8501"

# Optional
# GEMINI_MODEL = "gemini-3.8-flash"
# GEMINI_FALLBACK_MODELS = "model-a,model-b"
# DEMO_FREELANCER_EMAIL = "sb-xxxx@business.example.com"
